<Window x:Class="ReelPlayer.App.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts" Width="520" Height="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Opacity="0.7" TextWrapping="Wrap"
                   Text="Change these in Tools › Preferences › Hotkeys. Mouse: double-click video = fullscreen, wheel = volume, right-click = menu." />
        <ListView x:Name="List" ItemContainerStyle="{StaticResource GridRowItem}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Action" Width="250" DisplayMemberBinding="{Binding Description}" />
                    <GridViewColumn Header="Keys" Width="210" DisplayMemberBinding="{Binding Keys}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
