<Window x:Class="ReelPlayer.App.Views.EffectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjustments and Effects" Width="720" Height="470" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" MinWidth="90" IsCancel="True" Click="Close_Click" />
        </StackPanel>
        <TabControl>
            <TabItem Header="Audio Effects">
                <DockPanel Margin="6,12,6,6">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="PresetBox" Width="200" SelectionChanged="PresetBox_SelectionChanged" />
                        </StackPanel>
                        <CheckBox x:Name="EqEnable" Content="Enable equalizer" Checked="EqEnable_Changed" Unchecked="EqEnable_Changed" />
                    </DockPanel>
                    <Grid x:Name="BandGrid" IsEnabled="{Binding IsChecked, ElementName=EqEnable}" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Video Effects">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="6,12,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <CheckBox x:Name="AdjustEnable" Content="Image adjust" FontWeight="SemiBold" Checked="Adjust_Changed" Unchecked="Adjust_Changed" />
                            <Grid x:Name="AdjustGrid" Margin="0,8,0,0" IsEnabled="{Binding IsChecked, ElementName=AdjustEnable}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" />
                                    <RowDefinition Height="36" /><RowDefinition Height="36" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Brightness" VerticalAlignment="Center" />
                                <Slider x:Name="Brightness" Grid.Column="1" Minimum="0" Maximum="2" VerticalAlignment="Center" ValueChanged="Adjust_Changed" />
                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=Brightness, StringFormat=0.00}" VerticalAlignment="Center" TextAlignment="Right" />
                                <TextBlock Grid.Row="1" Text="Contrast" VerticalAlignment="Center" />
                                <Slider x:Name="Contrast" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="2" VerticalAlignment="Center" ValueChanged="Adjust_Changed" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=Contrast, StringFormat=0.00}" VerticalAlignment="Center" TextAlignment="Right" />
                                <TextBlock Grid.Row="2" Text="Hue" VerticalAlignment="Center" />
                                <Slider x:Name="Hue" Grid.Row="2" Grid.Column="1" Minimum="-180" Maximum="180" VerticalAlignment="Center" ValueChanged="Adjust_Changed" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=Hue, StringFormat=0}" VerticalAlignment="Center" TextAlignment="Right" />
                                <TextBlock Grid.Row="3" Text="Saturation" VerticalAlignment="Center" />
                                <Slider x:Name="Saturation" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="3" VerticalAlignment="Center" ValueChanged="Adjust_Changed" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Value, ElementName=Saturation, StringFormat=0.00}" VerticalAlignment="Center" TextAlignment="Right" />
                                <TextBlock Grid.Row="4" Text="Gamma" VerticalAlignment="Center" />
                                <Slider x:Name="Gamma" Grid.Row="4" Grid.Column="1" Minimum="0.01" Maximum="3" VerticalAlignment="Center" ValueChanged="Adjust_Changed" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Value, ElementName=Gamma, StringFormat=0.00}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>
                            <Button Content="Reset" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ResetAdjust_Click" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Geometry" FontWeight="SemiBold" />
                            <ComboBox x:Name="TransformBox" Margin="0,8,0,0" />
                            <CheckBox x:Name="SharpenEnable" Content="Sharpen" FontWeight="SemiBold" Margin="0,20,0,0" />
                            <DockPanel Margin="0,8,0,0" IsEnabled="{Binding IsChecked, ElementName=SharpenEnable}">
                                <TextBlock DockPanel.Dock="Left" Text="Sigma" VerticalAlignment="Center" Width="60" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=SharpenSigma, StringFormat=0.00}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                                <Slider x:Name="SharpenSigma" Minimum="0" Maximum="2" Value="0.05" VerticalAlignment="Center" />
                            </DockPanel>
                            <Button Content="Apply geometry and sharpen" Margin="0,16,0,0" HorizontalAlignment="Left" Click="ApplyFilters_Click" />
                            <TextBlock Text="Applying reopens the current media at the same position." Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
