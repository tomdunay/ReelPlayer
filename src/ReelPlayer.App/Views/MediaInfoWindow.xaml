<Window x:Class="ReelPlayer.App.Views.MediaInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Current Media Information" Width="620" Height="520" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="KeyValueRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" Opacity="0.75" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" Padding="0" MinHeight="0" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" MinWidth="90" IsCancel="True" Click="Close_Click" />
            <TextBox x:Name="LocationBox" IsReadOnly="True" Margin="0,0,10,0" ToolTip="Location" />
        </DockPanel>
        <TabControl x:Name="Tabs">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,10,4,4">
                    <ItemsControl x:Name="GeneralList" ItemTemplate="{StaticResource KeyValueRow}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Codec">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,10,4,4">
                    <ItemsControl x:Name="CodecList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource KeyValueRow}" Margin="12,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Statistics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,10,4,4">
                    <ItemsControl x:Name="StatsList" ItemTemplate="{StaticResource KeyValueRow}" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
