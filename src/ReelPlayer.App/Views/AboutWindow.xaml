<Window x:Class="ReelPlayer.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Reel Player" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/logo.png" Width="72" Height="72" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Reel Player" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Opacity="0.75" />
            </StackPanel>
        </StackPanel>
        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap">
            A media player for Windows that plays almost any video or audio format, disc and network stream.
        </TextBlock>
        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap">
            Playback is powered by <Bold>libVLC</Bold> from the VideoLAN project, used under the
            <Hyperlink NavigateUri="https://www.gnu.org/licenses/old-licenses/lgpl-2.1.html" RequestNavigate="Link_RequestNavigate">GNU LGPL 2.1 or later</Hyperlink>.
            libVLC is loaded dynamically and shipped unmodified; its source is available at
            <Hyperlink NavigateUri="https://code.videolan.org/videolan/vlc" RequestNavigate="Link_RequestNavigate">code.videolan.org</Hyperlink>.
            Reel Player is not affiliated with or endorsed by VideoLAN.
        </TextBlock>
        <TextBlock x:Name="LibVlcText" Margin="0,10,0,0" Opacity="0.75" TextWrapping="Wrap" />
        <TextBlock Margin="0,10,0,0" Opacity="0.75" TextWrapping="Wrap">
            Also uses LibVLCSharp (LGPL-2.1) and CommunityToolkit.Mvvm (MIT). See THIRD-PARTY-NOTICES.txt.
        </TextBlock>
        <Button Content="Close" HorizontalAlignment="Right" MinWidth="90" Margin="0,18,0,0" IsCancel="True" IsDefault="True" />
    </StackPanel>
</Window>
