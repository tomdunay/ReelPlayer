<Window x:Class="ReelPlayer.App.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Preferences" Width="680" Height="560" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Reset Preferences" Click="Reset_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" MinWidth="90" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" MinWidth="90" IsCancel="True" />
            </StackPanel>
        </DockPanel>

        <TabControl>
            <TabItem Header="Interface">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,0,6,6">
                        <TextBlock Text="Look and feel" Style="{StaticResource Section}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Theme:" VerticalAlignment="Center" Width="140" />
                            <ComboBox x:Name="ThemeBox" Width="180">
                                <ComboBoxItem Content="Dark" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="System" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Language:" VerticalAlignment="Center" Width="140" />
                            <ComboBox Width="180" SelectedIndex="0" IsEnabled="False" ToolTip="More languages are planned">
                                <ComboBoxItem Content="English" />
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="Instances and playlist" Style="{StaticResource Section}" />
                        <CheckBox x:Name="OneInstance" Content="Allow only one instance" />
                        <CheckBox x:Name="Enqueue" Content="Enqueue items into playlist in one instance mode" Margin="0,6,0,0"
                                  IsEnabled="{Binding IsChecked, ElementName=OneInstance}" />
                        <CheckBox x:Name="Resume" Content="Continue playback where I left off (files longer than 5 minutes)" Margin="0,6,0,0" />
                        <CheckBox x:Name="PauseOnMinimize" Content="Pause playback when minimized" Margin="0,6,0,0" />

                        <TextBlock Text="File associations" Style="{StaticResource Section}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Register file types…" Click="Associate_Click" Margin="0,0,8,0" />
                            <Button Content="Remove registration" Click="Unassociate_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Adds Reel Player to 'Open with' for your account (no admin rights needed), then opens Windows Default Apps so you can choose it as the default." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Audio / Video">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,0,6,6">
                        <TextBlock Text="Video" Style="{StaticResource Section}" />
                        <CheckBox x:Name="HwDecode" Content="Hardware-accelerated decoding (DXVA2 / D3D11)" />
                        <TextBlock Style="{StaticResource Hint}" Text="Takes effect after restarting Reel Player." />

                        <TextBlock Text="Video snapshots" Style="{StaticResource Section}" />
                        <DockPanel>
                            <TextBlock Text="Folder:" VerticalAlignment="Center" Width="80" />
                            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseSnapshot_Click" />
                            <TextBox x:Name="SnapshotFolder" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Format:" VerticalAlignment="Center" Width="80" />
                            <ComboBox x:Name="SnapshotFormat" Width="100">
                                <ComboBoxItem Content="png" />
                                <ComboBoxItem Content="jpg" />
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="Audio" Style="{StaticResource Section}" />
                        <TextBlock Text="The output device can be changed at any time from the Audio › Audio Device menu while something plays." Style="{StaticResource Hint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Subtitles">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,0,6,6">
                        <TextBlock Text="Subtitle language" Style="{StaticResource Section}" />
                        <CheckBox x:Name="AutoSubs" Content="Automatically load subtitle files next to the video" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Preferred language:" VerticalAlignment="Center" Width="160" />
                            <TextBox x:Name="SubLanguage" Width="160" ToolTip="Comma-separated ISO codes, e.g. en,fr" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Default encoding:" VerticalAlignment="Center" Width="160" />
                            <ComboBox x:Name="SubEncoding" Width="220" IsEditable="True" />
                        </StackPanel>

                        <TextBlock Text="Display settings" Style="{StaticResource Section}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Font size:" VerticalAlignment="Center" Width="160" />
                            <ComboBox x:Name="SubSize" Width="160">
                                <ComboBoxItem Content="Smaller" /><ComboBoxItem Content="Small" /><ComboBoxItem Content="Normal" />
                                <ComboBoxItem Content="Large" /><ComboBoxItem Content="Larger" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Text color:" VerticalAlignment="Center" Width="160" />
                            <ComboBox x:Name="SubColor" Width="160">
                                <ComboBoxItem Content="White" Tag="#FFFFFF" /><ComboBoxItem Content="Yellow" Tag="#FFFF00" />
                                <ComboBoxItem Content="Light gray" Tag="#C0C0C0" /><ComboBoxItem Content="Cyan" Tag="#00FFFF" />
                                <ComboBoxItem Content="Green" Tag="#00FF00" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Outline thickness:" VerticalAlignment="Center" Width="160" />
                            <ComboBox x:Name="SubOutline" Width="160">
                                <ComboBoxItem Content="None" /><ComboBoxItem Content="Thin" /><ComboBoxItem Content="Normal" /><ComboBoxItem Content="Thick" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Subtitle settings take effect after restarting Reel Player." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Hotkeys">
                <DockPanel Margin="6,10,6,6">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Select a row, then click the Hotkey box and press the new key combination. Backspace clears it. Separate several keys with |." />
                    <Button DockPanel.Dock="Bottom" Content="Restore defaults" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ResetHotkeys_Click" />
                    <ListView x:Name="HotkeyList" ItemContainerStyle="{StaticResource GridRowItem}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Action" Width="260" DisplayMemberBinding="{Binding Description}" />
                                <GridViewColumn Header="Hotkey" Width="290">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Gestures, UpdateSourceTrigger=PropertyChanged}" Width="260"
                                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
