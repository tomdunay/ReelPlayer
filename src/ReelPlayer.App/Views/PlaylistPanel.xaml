<UserControl x:Class="ReelPlayer.App.Views.PlaylistPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             Background="{DynamicResource LayerFillColorDefaultBrush}">
    <Border BorderThickness="1,0,0,0" BorderBrush="{StaticResource HairlineBrush}">
        <DockPanel>
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="14,12,12,8">
                <Border DockPanel.Dock="Right" Background="#1C808080" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Typography.NumeralAlignment="Tabular" />
                </Border>
                <TextBlock Text="Playlist" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Search box with icon & clear button -->
            <Grid DockPanel.Dock="Top" Margin="10,0,10,8">
                <TextBox x:Name="SearchBox" Padding="28,6,26,6" FontSize="12.5" TextChanged="SearchBox_TextChanged" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="10,0,0,0"
                           VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Search playlist…" Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="ClearSearchButton" Content="&#xE711;" FontSize="10"
                        Width="22" Height="22" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip="Clear search" Click="ClearSearch_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Bottom toolbar -->
            <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource HairlineBrush}" Padding="8,5">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Add files" Tag="OpenMultiple" Click="Action_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="Add folder" Tag="OpenFolder" Click="Action_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE738;" ToolTip="Remove selected (Delete)" Click="Remove_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Clear playlist" Click="Clear_Click" />
                    <Button x:Name="SortButton" Style="{StaticResource IconButton}" Content="&#xE8CB;" ToolTip="Sort" Click="Sort_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="By title" Tag="title" Click="SortItem_Click" />
                                <MenuItem Header="By title (descending)" Tag="title-desc" Click="SortItem_Click" />
                                <MenuItem Header="By duration" Tag="duration" Click="SortItem_Click" />
                                <MenuItem Header="By path" Tag="path" Click="SortItem_Click" />
                                <MenuItem Header="Random" Tag="random" Click="SortItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="Save playlist" Tag="SavePlaylist" Click="Action_Click" />
                </StackPanel>
            </Border>

            <!-- Clean row list -->
            <ListView x:Name="List" SelectionMode="Extended" AllowDrop="True" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"
                      PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove"
                      DragOver="List_DragOver" Drop="List_Drop">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource PlaylistRowItem}">
                        <Setter Property="ToolTip" Value="{Binding Location}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="16" CornerRadius="1.5" Margin="0,0,8,0"
                                    Background="{StaticResource SeekFillBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{StaticResource SeekFillBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Margin="10,0,2,0"
                                       VerticalAlignment="Center" FontSize="11.5" Opacity="0.65"
                                       Typography.NumeralAlignment="Tabular" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>
    </Border>
</UserControl>
