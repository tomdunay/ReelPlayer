<Window x:Class="ReelPlayer.App.Views.JumpToTimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go to Time" Width="320" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="Prompt" Text="Go to time (h:mm:ss):" />
        <TextBox x:Name="TimeBox" Margin="0,8,0,0" />
        <TextBlock x:Name="ErrorText" Foreground="#FFE5484D" Margin="0,6,0,0" Visibility="Collapsed" Text="Enter a time such as 1:02:30, 12:30 or 90." TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Go" MinWidth="80" IsDefault="True" Margin="0,0,8,0" Click="Go_Click" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
