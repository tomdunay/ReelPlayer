<Window x:Class="ReelPlayer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:controls="clr-namespace:ReelPlayer.App.Controls"
        Title="Reel Player" Icon="/Assets/app.ico"
        Width="960" Height="600" MinWidth="480" MinHeight="280"
        AllowDrop="True" UseLayoutRounding="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Taskbar thumbnail-toolbar glyphs. -->
        <DrawingImage x:Key="ThumbPrev">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M2,2 H4 V14 H2 Z M14,2 V14 L5,8 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="ThumbNext">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M12,2 H14 V14 H12 Z M2,2 V14 L11,8 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="ThumbPlay">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M3,1 V15 L14,8 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="ThumbPause">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M3,2 H6.5 V14 H3 Z M9.5,2 H13 V14 H9.5 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="ThumbPrevButton" Description="Previous" ImageSource="{StaticResource ThumbPrev}" Click="ThumbPrev_Click" />
                <ThumbButtonInfo x:Name="ThumbPlayButton" Description="Play" ImageSource="{StaticResource ThumbPlay}" Click="ThumbPlay_Click" />
                <ThumbButtonInfo x:Name="ThumbNextButton" Description="Next" ImageSource="{StaticResource ThumbNext}" Click="ThumbNext_Click" />
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <DockPanel x:Name="RootPanel">
        <!-- ===================== Integrated Title + Menu Bar ===================== -->
        <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="34" BorderThickness="0,0,0,1" BorderBrush="{StaticResource HairlineBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Source="/Assets/logo.png" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
                    <Menu x:Name="MainMenu" Background="Transparent" VerticalAlignment="Center" FontSize="12.5">
                        <Menu.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </Menu.ItemContainerStyle>
                        <MenuItem Header="_Media">
                            <MenuItem Header="_Open File…" Tag="OpenFile" />
                            <MenuItem Header="Open _Multiple Files…" Tag="OpenMultiple" />
                            <MenuItem Header="Open _Folder…" Tag="OpenFolder" />
                            <MenuItem Header="Open _Disc…" Tag="OpenDisc" />
                            <MenuItem Header="Open _Network Stream…" Tag="OpenNetwork" />
                            <MenuItem Header="Open _Capture Device…" Tag="OpenCapture" />
                            <Separator />
                            <MenuItem Header="Sa_ve Playlist to File…" Tag="SavePlaylist" />
                            <Separator />
                            <MenuItem Header="_Quit" Tag="Quit" />
                        </MenuItem>
                        <MenuItem Header="P_layback">
                            <MenuItem Header="_Title" Tag="dyn:Title"><MenuItem Header="(empty)" /></MenuItem>
                            <MenuItem Header="_Chapter" Tag="dyn:Chapter"><MenuItem Header="(empty)" /></MenuItem>
                            <Separator />
                            <MenuItem Header="_Speed" Tag="dyn:Speed"><MenuItem Header="(empty)" /></MenuItem>
                            <Separator />
                            <MenuItem Header="_Jump Forward" Tag="SeekFwd10" />
                            <MenuItem Header="Jump Bac_kward" Tag="SeekBack10" />
                            <MenuItem Header="Jump to Specific _Time…" Tag="JumpToTime" />
                            <Separator />
                            <MenuItem Header="_Record" Tag="Record" />
                            <Separator />
                            <MenuItem Header="_Play / Pause" Tag="PlayPause" />
                            <MenuItem Header="_Stop" Tag="Stop" />
                            <MenuItem Header="Pre_vious" Tag="Previous" />
                            <MenuItem Header="Ne_xt" Tag="Next" />
                            <MenuItem Header="Next _Frame" Tag="NextFrame" />
                        </MenuItem>
                        <MenuItem Header="_Audio">
                            <MenuItem Header="Audio _Track" Tag="dyn:AudioTrack"><MenuItem Header="(empty)" /></MenuItem>
                            <MenuItem Header="Audio _Device" Tag="dyn:AudioDevice"><MenuItem Header="(empty)" /></MenuItem>
                            <MenuItem Header="_Stereo Mode" Tag="dyn:Stereo"><MenuItem Header="(empty)" /></MenuItem>
                            <Separator />
                            <MenuItem Header="_Increase Volume" Tag="VolumeUp" />
                            <MenuItem Header="_Decrease Volume" Tag="VolumeDown" />
                            <MenuItem Header="_Mute" Tag="Mute" />
                        </MenuItem>
                        <MenuItem Header="_Video">
                            <MenuItem Header="Video _Track" Tag="dyn:VideoTrack"><MenuItem Header="(empty)" /></MenuItem>
                            <Separator />
                            <MenuItem Header="_Fullscreen" Tag="Fullscreen" />
                            <MenuItem Header="Always _on Top" Tag="AlwaysOnTop" />
                            <Separator />
                            <MenuItem Header="_Zoom" Tag="dyn:Zoom"><MenuItem Header="(empty)" /></MenuItem>
                            <MenuItem Header="_Aspect Ratio" Tag="dyn:Aspect"><MenuItem Header="(empty)" /></MenuItem>
                            <MenuItem Header="_Crop" Tag="dyn:Crop"><MenuItem Header="(empty)" /></MenuItem>
                            <Separator />
                            <MenuItem Header="_Deinterlace" Tag="dyn:Deinterlace"><MenuItem Header="(empty)" /></MenuItem>
                            <Separator />
                            <MenuItem Header="_Rotate 90°" Tag="RotateVideo" />
                            <MenuItem Header="Take _Snapshot" Tag="Snapshot" />
                        </MenuItem>
                        <MenuItem Header="Subti_tle">
                            <MenuItem Header="_Add Subtitle File…" Tag="AddSubtitle" />
                            <MenuItem Header="Sub _Track" Tag="dyn:SubTrack"><MenuItem Header="(empty)" /></MenuItem>
                            <Separator />
                            <MenuItem Header="_Delay -50 ms" Tag="SubDelayDown" />
                            <MenuItem Header="D_elay +50 ms" Tag="SubDelayUp" />
                        </MenuItem>
                        <MenuItem Header="T_ools">
                            <MenuItem Header="_Effects and Filters…" Tag="Effects" />
                            <MenuItem Header="_Track Synchronization…" Tag="Sync" />
                            <MenuItem Header="Media _Information…" Tag="MediaInfo" />
                            <MenuItem Header="_Codec Information…" Tag="CodecInfo" />
                            <Separator />
                            <MenuItem Header="_Messages…" Tag="Messages" />
                            <Separator />
                            <MenuItem Header="_Preferences…" Tag="Preferences" />
                        </MenuItem>
                        <MenuItem Header="V_iew">
                            <MenuItem Header="_Playlist" Tag="TogglePlaylist" />
                            <MenuItem Header="_Minimal Interface" Tag="MinimalInterface" />
                            <MenuItem Header="_Status Bar" Tag="ToggleStatusBar" />
                            <MenuItem Header="_Fullscreen Interface" Tag="Fullscreen" />
                        </MenuItem>
                        <MenuItem Header="_Help">
                            <MenuItem Header="_Keyboard Shortcuts" Tag="Shortcuts" />
                            <MenuItem Header="_About" Tag="About" />
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- Centered media title (drag handle area) -->
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Margin="12,0" FontSize="12" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- Window caption buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
                    <Button x:Name="MaxRestoreButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" Click="MaxRestore_Click" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Status bar ===================== -->
        <Border x:Name="StatusBarPanel" DockPanel.Dock="Bottom" Padding="12,3" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource HairlineBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Typography.NumeralAlignment="Tabular">
                    <Run Text="{Binding Rate, StringFormat={}{0:0.00}×, Mode=OneWay}" />
                    <Run Text="   ·   " />
                    <Run Text="{Binding StatusText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Title}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
        </Border>

        <!-- ===================== Docked controls ===================== -->
        <Border x:Name="DockedControlsHost" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource HairlineBrush}">
            <controls:ControlBar x:Name="DockedControls" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Border>

        <!-- ===================== Video + playlist ===================== -->
        <Grid x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PlaylistColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <vlc:VideoView x:Name="VideoView" Background="Black">
                <!-- Content of VideoView is drawn in a transparent window above the video (avoids WPF airspace issues).
                     The near-transparent background makes the whole area hit-testable for clicks, wheel and drops. -->
                <Grid x:Name="OverlayRoot" AllowDrop="True" Cursor="Arrow">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Background" Value="#01000000" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIdle}" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.7" RadiusY="0.7">
                                                <GradientStop Color="#FF15171E" Offset="0" />
                                                <GradientStop Color="#FF0A0B0F" Offset="1" />
                                            </RadialGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- Idle welcome state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                        <Image Source="/Assets/logo.png" Width="96" Height="96" Opacity="0.92" IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Reel Player" Margin="0,14,0,0" Foreground="#F0FFFFFF" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" FontSize="20" IsHitTestVisible="False" />
                        <TextBlock Text="Drop a video, audio file, or playlist here" Margin="0,5,0,16" Foreground="#88FFFFFF"
                                   HorizontalAlignment="Center" FontSize="13" IsHitTestVisible="False" />
                        <Button Style="{StaticResource PillButton}" Content="Open File" HorizontalAlignment="Center"
                                Click="IdleOpen_Click" />
                    </StackPanel>

                    <!-- Drag-over highlight -->
                    <Border x:Name="DropOverlay" Background="#AA0B0E14" Visibility="Collapsed" IsHitTestVisible="False" Padding="24">
                        <Border BorderBrush="{StaticResource SeekFillBrush}" BorderThickness="2" CornerRadius="14" Background="#1414B8A6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="34"
                                           Foreground="{StaticResource SeekFillBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Drop media to play" Margin="0,10,0,0" Foreground="White"
                                           FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Error toast -->
                    <Border x:Name="ErrorBanner" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16"
                            Background="#E67F1D1D" BorderBrush="#48FCA5A5" BorderThickness="1"
                            CornerRadius="10" Padding="12,8" Visibility="Collapsed" MaxWidth="620">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Foreground="White"
                                    Width="24" Height="24" FontSize="11" Margin="10,0,0,0" Click="ErrorClose_Click" />
                            <TextBlock DockPanel.Dock="Left" Text="&#xE783;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="#FFFCA5A5" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="ErrorText" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </Border>

                    <!-- Frosted OSD pill badge -->
                    <Border x:Name="OsdBadge" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,18,20,0"
                            Background="{StaticResource OverlayBrush}" BorderBrush="{StaticResource OverlayBorderBrush}"
                            BorderThickness="1" CornerRadius="18" Padding="16,7" IsHitTestVisible="False" Opacity="0" MaxWidth="560">
                        <TextBlock x:Name="OsdText" Foreground="{StaticResource OverlayTextBrush}" FontSize="15"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                    </Border>

                    <!-- Bottom gradient scrim behind fullscreen controller -->
                    <Rectangle x:Name="FullscreenScrim" VerticalAlignment="Bottom" Height="130" IsHitTestVisible="False"
                               Visibility="Collapsed" Opacity="0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#B8000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Fullscreen controller pill (auto-hides, created on first fullscreen) -->
                    <Border x:Name="FullscreenControlsHost" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="36,0,36,22"
                            MaxWidth="960" CornerRadius="14" Background="{StaticResource OverlayBrush}"
                            BorderBrush="{StaticResource OverlayBorderBrush}" BorderThickness="1"
                            Visibility="Collapsed" Opacity="0" />
                </Grid>
            </vlc:VideoView>

            <GridSplitter x:Name="PlaylistSplitter" Grid.Column="1" Width="4" ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch" Background="Transparent" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
