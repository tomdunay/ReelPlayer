<Application x:Class="ReelPlayer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ReelPlayer.App.Controls"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <controls:SliderFillConverter x:Key="SliderFill" />
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- Fixed colours for the video chrome (always dark over video, like most players). -->
            <SolidColorBrush x:Key="OverlayBrush" Color="#E0141418" />
            <SolidColorBrush x:Key="OverlayTextBrush" Color="#FFF2F2F2" />
            <SolidColorBrush x:Key="SeekTrackBrush" Color="#66808080" />
            <SolidColorBrush x:Key="SeekFillBrush" Color="#FF14B8A6" />
            <SolidColorBrush x:Key="ChapterMarkBrush" Color="#FFFFD166" />

            <!-- Flat icon button used in the control bar. -->
            <Style x:Key="IconButton" TargetType="ButtonBase">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="Focusable" Value="False" />
                <!-- Follow the hosting bar's colour (themed when docked, white over video in fullscreen). -->
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ButtonBase">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33808080" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#55808080" />
                                </Trigger>
                                <Trigger Property="ToggleButton.IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SeekFillBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BigIconButton" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="38" />
            </Style>

            <!-- Thin media slider: track + fill + round thumb, click-to-position. -->
            <Style x:Key="MediaSlider" TargetType="Slider">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid x:Name="Root" Background="Transparent" Height="18">
                                <!-- Track and fill are drawn here, not by the RepeatButtons (the Fluent theme restyles those). -->
                                <Border x:Name="TrackBg" Height="4" CornerRadius="2" Margin="6,0" Background="{StaticResource SeekTrackBrush}" />
                                <Border Height="4" CornerRadius="2" Margin="6,0" HorizontalAlignment="Left" Background="{StaticResource SeekFillBrush}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource SliderFill}">
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="ActualWidth" ElementName="TrackBg" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse x:Name="Knob" Width="12" Height="12" Fill="White" Stroke="{StaticResource SeekFillBrush}" StrokeThickness="2" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Knob" Property="Width" Value="14" />
                                                            <Setter TargetName="Knob" Property="Height" Value="14" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ListView rows that honour GridView columns (the Fluent ListViewItem template shows only one cell). -->
            <Style x:Key="GridRowItem" TargetType="ListViewItem">
                <Setter Property="Padding" Value="4,3" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}">
                                <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22808080" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#44808080" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OsdText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.9" Color="Black" />
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
