<UserControl x:Class="ReelPlayer.App.Controls.ControlBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="12,6,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Seek row -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ElapsedText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       VerticalAlignment="Center" MinWidth="50" FontSize="12" Opacity="0.82" TextAlignment="Left"
                       Typography.NumeralAlignment="Tabular" />
            <Grid Grid.Column="1" Margin="8,0">
                <Slider x:Name="SeekSlider" Style="{StaticResource MediaSlider}" Minimum="0" Maximum="1"
                        IsEnabled="{Binding IsSeekable}" ToolTipService.IsEnabled="False" />
                <Canvas x:Name="ChapterCanvas" IsHitTestVisible="False" VerticalAlignment="Center" Height="18" />
                <Popup x:Name="SeekTip" PlacementTarget="{Binding ElementName=SeekSlider}" Placement="Top"
                       AllowsTransparency="True" IsHitTestVisible="False" VerticalOffset="-4">
                    <Border Background="{StaticResource OverlayBrush}" BorderBrush="{StaticResource OverlayBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,4" MaxWidth="280">
                        <StackPanel>
                            <TextBlock x:Name="SeekTipChapter" Foreground="#CCFFFFFF" FontSize="11" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,1" />
                            <TextBlock x:Name="SeekTipText" Foreground="White" FontSize="12" FontWeight="Medium"
                                       HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="{Binding TotalText}" Cursor="Hand"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       ToolTip="Click to toggle total / remaining time" MouseLeftButtonUp="TotalTime_Click"
                       VerticalAlignment="Center" MinWidth="50" FontSize="12" Opacity="0.82" TextAlignment="Right"
                       Typography.NumeralAlignment="Tabular" />
        </Grid>

        <!-- Controls row: secondary left | primary transport centered | volume & tools right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: loop, shuffle, active speed badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Tag="CycleLoop" Content="{Binding LoopIcon}" ToolTip="{Binding LoopTip}" Click="Action_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoopOn}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SeekFillBrush}" />
                                    <Setter Property="Background" Value="{StaticResource ActivePillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Tag="ToggleShuffle" Content="&#xE8B1;" ToolTip="Random (shuffle)" Click="Action_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Shuffle}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SeekFillBrush}" />
                                    <Setter Property="Background" Value="{StaticResource ActivePillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Tag="NormalSpeed" Content="{Binding RateText}" ToolTip="Playback speed (click to reset to 1×)"
                        Click="Action_Click" Margin="6,0,0,0" Focusable="False" Cursor="Hand"
                        Visibility="{Binding IsNonNormalRate, Converter={StaticResource BoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource ActivePillBrush}" CornerRadius="10" Padding="8,3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4014B8A6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>
                        <StaticResource ResourceKey="SeekFillBrush" />
                    </Button.Foreground>
                    <Button.FontSize>11.5</Button.FontSize>
                    <Button.FontWeight>SemiBold</Button.FontWeight>
                </Button>
                <!-- Active A-B loop pill (click to cycle/clear) -->
                <Button Tag="AbLoop" Content="{Binding AbLoopText}" ToolTip="A-B loop (Shift+L — click to set B or clear)"
                        Click="Action_Click" Margin="6,0,0,0" Focusable="False" Cursor="Hand"
                        Visibility="{Binding IsAbLoopActive, Converter={StaticResource BoolToVis}}"
                        Foreground="{StaticResource ChapterMarkBrush}" FontSize="11.5" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#28FFD166" BorderBrush="#44FFD166" BorderThickness="1" CornerRadius="10" Padding="8,3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#40FFD166" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Inline resume prompt (replaces the old floating overlay over the video) -->
                <Border Visibility="{Binding HasResumeOffer, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource ActivePillBrush}" BorderBrush="#4414B8A6" BorderThickness="1"
                        CornerRadius="12" Margin="8,0,0,0" Padding="2,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Tag="AcceptResume" Click="Action_Click" Focusable="False" Cursor="Hand"
                                ToolTip="Continue playback where you left off" Padding="8,3,6,3">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       Foreground="{StaticResource SeekFillBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding ResumeOfferText}" Foreground="{StaticResource SeekFillBrush}"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2614B8A6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Tag="DismissResume" Click="Action_Click"
                                Content="&#xE711;" FontSize="9.5" Width="22" Height="22" Margin="0,0,2,0"
                                Foreground="{StaticResource SeekFillBrush}" ToolTip="Dismiss" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Center: core transport -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous media in the playlist" Tag="Previous" Click="Action_Click" />
                <Button Style="{StaticResource PlayIconButton}" Content="{Binding PlayPauseIcon}" ToolTip="{Binding PlayPauseTip}" Tag="PlayPause" Click="Action_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Stop playback" Tag="Stop" Click="Action_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next media in the playlist" Tag="Next" Click="Action_Click" />
            </StackPanel>

            <!-- Right: volume + effects, playlist, fullscreen -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="{Binding VolumeIcon}" ToolTip="Mute / unmute" Tag="Mute" Click="Action_Click" />
                <Slider x:Name="VolumeSlider" Style="{StaticResource MediaSlider}" Width="92" Minimum="0" Maximum="200"
                        SmallChange="5" LargeChange="10" Value="{Binding Volume, Mode=TwoWay}" Margin="2,0"
                        ToolTip="Volume (up to 200%)" MouseWheel="VolumeSlider_MouseWheel" />
                <TextBlock Text="{Binding VolumeText}" VerticalAlignment="Center" MinWidth="34" FontSize="11.5" Opacity="0.82"
                           TextAlignment="Right" Typography.NumeralAlignment="Tabular"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Rectangle Width="1" Height="18" Margin="8,0" Fill="{StaticResource HairlineBrush}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE722;" ToolTip="Take snapshot (Shift+S)"
                        Tag="Snapshot" IsEnabled="{Binding HasVideo}" Click="Action_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE9E9;" ToolTip="Effects and filters (Ctrl+E)" Tag="Effects" Click="Action_Click" />
                <Button Tag="TogglePlaylist" Content="&#xE8FD;" ToolTip="Toggle playlist (Ctrl+L)" Click="Action_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaylistVisible}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SeekFillBrush}" />
                                    <Setter Property="Background" Value="{StaticResource ActivePillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="{Binding FullscreenIcon}" ToolTip="Toggle fullscreen (F)" Tag="Fullscreen" Click="Action_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
