<UserControl x:Class="ReelPlayer.App.Controls.ControlBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800">
    <Grid Margin="8,4,8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Seek row -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ElapsedText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       VerticalAlignment="Center" MinWidth="52" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" TextAlignment="Left" />
            <Grid Grid.Column="1" Margin="6,0">
                <Slider x:Name="SeekSlider" Style="{StaticResource MediaSlider}" Minimum="0" Maximum="1"
                        IsEnabled="{Binding IsSeekable}" ToolTipService.IsEnabled="False" />
                <Canvas x:Name="ChapterCanvas" IsHitTestVisible="False" VerticalAlignment="Center" Height="18" />
                <Popup x:Name="SeekTip" PlacementTarget="{Binding ElementName=SeekSlider}" Placement="Top"
                       AllowsTransparency="True" IsHitTestVisible="False" VerticalOffset="-2">
                    <Border Background="#EE1E1E22" CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="SeekTipText" Foreground="White" FontSize="12" />
                    </Border>
                </Popup>
            </Grid>
            <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="{Binding TotalText}" Cursor="Hand"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       ToolTip="Click to toggle total / remaining time" MouseLeftButtonUp="TotalTime_Click"
                       VerticalAlignment="Center" MinWidth="52" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" TextAlignment="Right" />
        </Grid>

        <!-- Buttons row -->
        <DockPanel Grid.Row="1" Margin="0,2,0,0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Button Style="{StaticResource BigIconButton}" Content="{Binding PlayPauseIcon}" ToolTip="{Binding PlayPauseTip}" Tag="PlayPause" Click="Action_Click" />
                <Rectangle Width="6" />
                <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous media in the playlist" Tag="Previous" Click="Action_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Stop playback" Tag="Stop" Click="Action_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next media in the playlist" Tag="Next" Click="Action_Click" />
                <Rectangle Width="1" Height="20" Margin="8,0" Fill="#40808080" />
                <Button Style="{StaticResource IconButton}" Content="{Binding FullscreenIcon}" ToolTip="Toggle fullscreen" Tag="Fullscreen" Click="Action_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE9E9;" ToolTip="Show extended settings (effects and filters)" Tag="Effects" Click="Action_Click" />
                <Button Tag="TogglePlaylist" Content="&#xE8FD;" ToolTip="Toggle playlist" Click="Action_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaylistVisible}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SeekFillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Tag="CycleLoop" Content="{Binding LoopIcon}" ToolTip="{Binding LoopTip}" Click="Action_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoopOn}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SeekFillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Tag="ToggleShuffle" Content="&#xE8B1;" ToolTip="Random (shuffle)" Click="Action_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Shuffle}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SeekFillBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="{Binding VolumeIcon}" ToolTip="Mute / unmute" Tag="Mute" Click="Action_Click" />
                <Slider x:Name="VolumeSlider" Style="{StaticResource MediaSlider}" Width="110" Minimum="0" Maximum="200"
                        SmallChange="5" LargeChange="10" Value="{Binding Volume, Mode=TwoWay}" Margin="4,0"
                        ToolTip="Volume (up to 200%)" MouseWheel="VolumeSlider_MouseWheel" />
                <TextBlock Text="{Binding VolumeText}" VerticalAlignment="Center" MinWidth="38" FontSize="12" TextAlignment="Right"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
