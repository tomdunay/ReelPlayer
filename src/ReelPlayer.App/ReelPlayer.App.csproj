<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>ReelPlayer.App.Program</StartupObject>
    <!-- Plain Windows TFM: SMTC is reached through raw COM (Services/MediaControls.cs) instead of the 50 MB
         Windows SDK projection that a versioned TFM (net10.0-windows10.0.x) would pull in. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The UI is English-only: don't ship WPF/.NET resource translations. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ReelPlayer</AssemblyName>
    <RootNamespace>ReelPlayer.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Reel Player</Product>
    <Description>Reel Player media player</Description>
    <Version>1.0.0</Version>
    <Copyright>Reel Player contributors. Uses libVLC (LGPL-2.1-or-later).</Copyright>
    <!-- Fluent ThemeMode is marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <!-- Ship only the libVLC build matching the target runtime (the package copies all three for AnyCPU). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <VlcWindowsX64Enabled>false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <VlcWindowsX64Enabled Condition="'$(RuntimeIdentifier)' == 'win-x64'">true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled Condition="'$(RuntimeIdentifier)' == 'win-x86'">true</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled Condition="'$(RuntimeIdentifier)' == 'win-arm64'">true</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <!--
    libVLC files this app can never use, because it never configures the feature that loads them:
    - .lib import libraries; audio visualizations; video wall/clone splitters
    - stream output beyond Record's file + MPEG-TS + duplicate/display path (SRT/RIST/HTTP/UDP/shout outputs,
      Chromecast, transcoding, x264/QuickSync/MP2 encoders, other muxers)
    - service discovery (UPnP/mDNS), add-ons manager, AcoustID fingerprinting
    - overlay sub-sources (logo/marquee stay: the player object registers their options) and user-selected "effect" filters that only VLC's own UI exposes
    - ASCII-art / LED-wall / raw-YUV video outputs, memory-input access, record stream filter
    - Lua web/telnet interfaces, VLC extensions and service-discovery scripts (playlist + meta scripts stay)
    Every decoder, demuxer, access protocol, deinterlacer and the adjust/transform/sharpen filters are kept.
  -->
  <PropertyGroup>
    <VlcUnusedFiles>libvlc.lib;libvlccore.lib;plugins\visualization\%2A;plugins\video_splitter\%2A;plugins\services_discovery\%2A;plugins\spu\libaudiobargraph_v_plugin.dll;plugins\spu\libmosaic_plugin.dll;plugins\spu\libremoteosd_plugin.dll;plugins\spu\librss_plugin.dll;plugins\spu\libsubsdelay_plugin.dll;lua\intf\%2A%2A;lua\http\%2A%2A;lua\extensions\%2A%2A;lua\sd\%2A%2A;plugins\access_output\libaccess_output_srt_plugin.dll;plugins\access_output\libaccess_output_rist_plugin.dll;plugins\access_output\libaccess_output_livehttp_plugin.dll;plugins\access_output\libaccess_output_shout_plugin.dll;plugins\access_output\libaccess_output_http_plugin.dll;plugins\access_output\libaccess_output_udp_plugin.dll;plugins\access_output\libaccess_output_dummy_plugin.dll;plugins\stream_out\libstream_out_chromaprint_plugin.dll;plugins\stream_out\libstream_out_chromecast_plugin.dll;plugins\stream_out\libstream_out_record_plugin.dll;plugins\stream_out\libstream_out_transcode_plugin.dll;plugins\stream_out\libstream_out_bridge_plugin.dll;plugins\stream_out\libstream_out_stats_plugin.dll;plugins\stream_out\libstream_out_mosaic_bridge_plugin.dll;plugins\stream_out\libstream_out_es_plugin.dll;plugins\stream_out\libstream_out_smem_plugin.dll;plugins\stream_out\libstream_out_setid_plugin.dll;plugins\stream_out\libstream_out_gather_plugin.dll;plugins\stream_out\libstream_out_autodel_plugin.dll;plugins\stream_out\libstream_out_delay_plugin.dll;plugins\stream_out\libstream_out_description_plugin.dll;plugins\stream_out\libstream_out_dummy_plugin.dll;plugins\mux\libmux_mp4_plugin.dll;plugins\mux\libmux_ogg_plugin.dll;plugins\mux\libmux_ps_plugin.dll;plugins\mux\libmux_asf_plugin.dll;plugins\mux\libmux_mpjpeg_plugin.dll;plugins\mux\libmux_avi_plugin.dll;plugins\mux\libmux_wav_plugin.dll;plugins\mux\libmux_dummy_plugin.dll;plugins\codec\libx26410b_plugin.dll;plugins\codec\libqsv_plugin.dll;plugins\codec\libtwolame_plugin.dll;plugins\codec\libedummy_plugin.dll;plugins\misc\libaddonsfsstorage_plugin.dll;plugins\misc\libaddonsvorepository_plugin.dll;plugins\misc\libfingerprinter_plugin.dll;plugins\video_output\libcaca_plugin.dll;plugins\video_output\libflaschen_plugin.dll;plugins\video_output\libyuv_plugin.dll;plugins\video_filter\libpuzzle_plugin.dll;plugins\video_filter\libscene_plugin.dll;plugins\video_filter\libball_plugin.dll;plugins\video_filter\libgradient_plugin.dll;plugins\video_filter\liboldmovie_plugin.dll;plugins\video_filter\libbluescreen_plugin.dll;plugins\video_filter\libantiflicker_plugin.dll;plugins\video_filter\libmotiondetect_plugin.dll;plugins\video_filter\libmirror_plugin.dll;plugins\video_filter\liberase_plugin.dll;plugins\video_filter\libfreeze_plugin.dll;plugins\video_filter\libgaussianblur_plugin.dll;plugins\video_filter\libextract_plugin.dll;plugins\video_filter\libposterize_plugin.dll;plugins\video_filter\libanaglyph_plugin.dll;plugins\video_filter\libsepia_plugin.dll;plugins\video_filter\libvhs_plugin.dll;plugins\video_filter\libmagnify_plugin.dll;plugins\video_filter\libmotionblur_plugin.dll;plugins\video_filter\libcolorthres_plugin.dll;plugins\video_filter\libblendbench_plugin.dll;plugins\video_filter\libwave_plugin.dll;plugins\video_filter\libinvert_plugin.dll;plugins\video_filter\libpsychedelic_plugin.dll;plugins\video_filter\libripple_plugin.dll;plugins\video_filter\libalphamask_plugin.dll;plugins\video_filter\libedgedetection_plugin.dll;plugins\video_filter\libhqdn3d_plugin.dll;plugins\video_filter\libgradfun_plugin.dll;plugins\video_filter\libgrain_plugin.dll;plugins\video_filter\libcroppadd_plugin.dll;plugins\video_filter\libcanvas_plugin.dll;plugins\video_filter\libfps_plugin.dll;plugins\audio_filter\libaudiobargraph_a_plugin.dll;plugins\audio_filter\libkaraoke_plugin.dll;plugins\audio_filter\libchorus_flanger_plugin.dll;plugins\audio_filter\libcompressor_plugin.dll;plugins\audio_filter\libparam_eq_plugin.dll;plugins\audio_filter\libstereo_widen_plugin.dll;plugins\audio_filter\libspatializer_plugin.dll;plugins\audio_filter\libnormvol_plugin.dll;plugins\audio_filter\libgain_plugin.dll;plugins\demux\libdemux_chromecast_plugin.dll;plugins\demux\libdemuxdump_plugin.dll;plugins\stream_filter\librecord_plugin.dll;plugins\access\libaccess_imem_plugin.dll;plugins\access\libimem_plugin.dll</VlcUnusedFiles>
  </PropertyGroup>
  <ItemGroup>
    <VlcWindowsX64ExcludeFiles Include="$(VlcUnusedFiles)" />
    <VlcWindowsX86ExcludeFiles Include="$(VlcUnusedFiles)" />
    <VlcWindowsArm64ExcludeFiles Include="$(VlcUnusedFiles)" />
  </ItemGroup>

  <!-- libVLC loads its plugins from disk, so its folder must stay next to the exe rather than inside the single-file bundle. -->
  <Target Name="KeepLibVlcOutOfBundle" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('libvlc'))"
                             ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReelPlayer.Core\ReelPlayer.Core.csproj" />
  </ItemGroup>

</Project>
